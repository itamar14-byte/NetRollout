# Stored as LF in the repo; checked out per platform unless pinned below
* text=auto

# Run inside Linux containers: must stay LF on every checkout
*.sh       text eol=lf
*.conf     text eol=lf
*.template text eol=lf
# Everything under deploy/ is read inside Linux containers
deploy/** text eol=lf

# Windows scripts
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

*.png      binary
*.ico      binary
*.bmp      binary

# Third-party files served as published (their checksums: src/static/vendor/SHA256SUMS)
src/static/vendor/** -text
# recorded device outputs (platform detection's test data): kept byte for byte
tests/unit/rollout/detect/** -text
