# NetRollout's Postgres: the official image + pg_cron (the nightly retention
# jobs), started with the settings pg_cron needs.
#
#   docker build -t netrollout-postgres deploy/postgres
#
# Environment (generated by the installer):
#   POSTGRES_PASSWORD       the superuser (first-start script, backups — never the app)
#   NETROLLOUT_DB_PASSWORD  the app's role, netrollout (not a superuser)
#   GRAFANA_DB_PASSWORD     grafana_reader (read-only, three tables)
#   TZ                      the retention jobs run at 03:00 in this timezone
# The first-start script runs only on an empty data volume: later password
# changes in .env don't reach the database by themselves.

FROM postgres:17-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-17-cron && \
    rm -rf /var/lib/apt/lists/*

ENV POSTGRES_DB=netrollout

COPY --chmod=755 netrollout-postgres.sh /usr/local/bin/
COPY --chmod=755 initdb/ /docker-entrypoint-initdb.d/

ENTRYPOINT ["netrollout-postgres.sh"]
CMD []
