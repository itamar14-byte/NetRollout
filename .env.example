# NetRollout settings for compose.yaml. The installer writes the real .env
# from this file (generated values marked GENERATED); keep .env private — it
# holds every secret of the installation. After editing it: docker compose up -d
#
# Passwords go into connection URLs: letters and digits only.

# ── Version ──────────────────────────────────────────────────────────────────
# The image tag to run (the release, e.g. 1.0.0). `update` changes it.
NETROLLOUT_VERSION=1.0.0

# ── Secrets (GENERATED — never reuse them across installations) ─────────────
# Postgres superuser: first-start setup and backups only, never the app
POSTGRES_PASSWORD=
# The app's database role (netrollout)
NETROLLOUT_DB_PASSWORD=
# Grafana's read-only database role (grafana_reader)
GRAFANA_DB_PASSWORD=
REDIS_PASSWORD=
# Grafana's own admin account (maintenance; people sign in through NetRollout)
GRAFANA_ADMIN_PASSWORD=
# Signs the browser sessions
SECRET_KEY=
# Encrypts the stored device credentials (a Fernet key). Losing it makes them
# unreadable; the app refuses to start with a missing or different key.
NETROLLOUT_ENCRYPTION_KEY=

# ── Installation (asked by the installer) ───────────────────────────────────
# The name people use; other names redirect to it (IPs don't). Blank: none.
# At the first start it also seeds System Settings, which rule after that.
NETROLLOUT_HOSTNAME=
# The HTTPS port people type (published by nginx)
HTTPS_PORT=443
# Port 80 → HTTPS redirect, published only through compose.http.yaml below
HTTP_PORT=80
# Rollout jobs that run at the same time (seeds System Settings)
ORCHESTRATOR_WORKERS=4
# Containers' timezone: log times, and the nightly retention jobs at 03:00
TZ=UTC

# ── Advanced ─────────────────────────────────────────────────────────────────
# Web server threads: each open live rollout log holds one (4–256)
NETROLLOUT_THREADS=32

# ── Switches ─────────────────────────────────────────────────────────────────
# Monitoring (Prometheus, Loki, Alloy, Grafana): keep the line to turn it on
COMPOSE_PROFILES=monitoring
# Port 80: list compose.http.yaml only when port 80 is free on this machine
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=compose.yaml,compose.http.yaml
